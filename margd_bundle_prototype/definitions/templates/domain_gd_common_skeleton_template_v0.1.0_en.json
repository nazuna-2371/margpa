{
  "domain_gd_common_skeleton_template": {
    "domain_governance_definition_template": {
      "template_description": {
        "purpose": "common skeleton for domain governance definitions across any subject, activity, discipline, workflow, governed target, or domain output type",
        "design_principle": "define only cross-domain governance structure; domain-specific substance must be inserted into declared domain delta slots or matching governance blocks",
        "abstraction_requirement": "use the highest safe abstraction level and avoid encoding domain instances, professional fields, media, tools, platforms, styles, workflows, or cases as universal rules",
        "finalization_policy": {
          "template_description_is_template_scaffolding": true,
          "remove_this_block_when_creating_a_final_domain_definition": true,
          "do_not_copy_template_only_explanations_into_final_domain_governance_unless_they_are_explicitly_needed": true
        }
      },
      "description": "",
      "template_fill_policy": {
        "template_only_empty_value_policy": {
          "empty_strings_allowed_in_template": true,
          "empty_arrays_allowed_in_template": true,
          "empty_objects_allowed_in_template": true,
          "finalized_domain_definition_must_resolve_required_placeholders": true,
          "unresolved_placeholders_must_be_reported_before_publication_or_runtime_use": true
        },
        "placeholder_resolution_policy": {
          "domain_specific_fields_must_be_filled_from_domain_requirements": true,
          "non_applicable_fields_may_remain_empty_only_with_explicit_non_applicability_reason": true,
          "template_defaults_must_not_be_treated_as_domain_substance": true,
          "copying_template_empty_slots_without_domain_review_is_prohibited": true
        },
        "domain_injection_policy": {
          "domain_substance_must_enter_through_domain_delta_slots_or_matching_governance_blocks": true,
          "domain_substance_must_not_modify_parent_boundary_or_external_orchestration_boundary_without_explicit_design_change": true,
          "domain_specific_examples_must_remain_non_normative_unless_promoted_by_requirements": true,
          "domain_specific_rules_must_use_the_highest_safe_abstraction_level": true
        },
        "template_scaffolding_removal_policy": {
          "template_only_blocks_must_be_removed_or_resolved_before_final_domain_release": true,
          "template_only_blocks": [
            "template_description",
            "template_fill_policy",
            "final_domain_conversion_check",
            "final_generation_sanity_check",
            "placeholder_registry",
            "domain_delta_slots",
            "output_lightness_and_authority_safety_policy"
          ],
          "template_guidance_must_not_remain_as_domain_substance": true,
          "final_domain_definition_should_keep_only_filled_domain_governance_blocks_and_needed_meta_data": true
        },
        "optional_structure_minimality_policy": {
          "optional_structures_must_not_be_enabled_just_because_the_template_contains_them": true,
          "scoring_severity_records_self_state_audit_and_audit_to_action_require_domain_reason_to_become_substantive": true,
          "empty_optional_structures_should_remain_empty_when_not_needed": true,
          "optional_structures_should_be_filled_with_the_smallest_domain_sufficient_structure": true,
          "domain_reason_must_be_stated_when_optional_structure_is_enabled": true,
          "do_not_create_complete_looking_structures_only_to_fill_template_slots": true
        }
      },
      "final_domain_conversion_check": {
        "purpose": "prevent template-only scaffolding or unresolved placeholders from being carried into a concrete domain governance definition",
        "template_only": true,
        "remove_this_block_when_creating_a_final_domain_definition": true,
        "checks": [
          "template_description_removed",
          "template_fill_policy_resolved_or_removed",
          "final_domain_conversion_check_removed",
          "placeholder_registry_resolved_or_removed",
          "domain_delta_slots_resolved_or_removed",
          "required_empty_strings_resolved",
          "required_empty_arrays_resolved",
          "domain_specific_blocks_filled_from_requirements",
          "parent_governance_boundary_preserved",
          "external_orchestration_not_reimplemented",
          "sibling_domains_not_absorbed",
          "compatibility_labels_reviewed",
          "meta_data_finalized",
          "representative_domain_lists_not_carried_into_common_template",
          "final_generation_sanity_check_removed",
          "output_lightness_and_authority_safety_policy_removed_or_resolved"
        ],
        "failure_policy": {
          "unresolved_template_scaffolding_blocks_release": false,
          "unresolved_required_placeholders_must_be_reported_or_repaired": true,
          "domain_specific_content_must_not_be_invented_to_fill_placeholders": true
        }
      },
      "final_generation_sanity_check": {
        "purpose": "prevent generated domain definitions from becoming overbuilt, authority-heavy, or internally inconsistent when expanding this common template",
        "template_only": true,
        "remove_this_block_when_creating_a_final_domain_definition": true,
        "checks": [
          "template_only_blocks_removed",
          "required_placeholders_resolved",
          "optional_structures_enabled_only_with_domain_reason",
          "records_kept_minimal_and_material_conditioned",
          "required_capabilities_all_mapped_to_capability_groups_when_groups_are_used",
          "record_required_fields_all_mapped_to_field_groups_when_records_exist",
          "scoring_dimensions_have_thresholds_when_scoring_enabled",
          "critical_invalidation_conditions_are_in_critical_severity_when_severity_enabled",
          "action_outputs_are_used_or_marked_reserved_or_payload_target",
          "decision_inputs_are_used_or_marked_reserved",
          "self_audit_or_self_doubt_results_are_mapped_or_marked_internal_only",
          "direct_authority_verbs_are_avoided_unless_the_domain_owns_that_authority",
          "human_or_runtime_review_wording_is_authority_safe",
          "collection_shapes_are_declared_when_grouped_objects_are_used",
          "consecutive_is_filled_as_external_candidate_sequence_when_applicable"
        ],
        "failure_policy": {
          "overbuilt_optional_structures_should_be_reduced_or_justified": true,
          "unused_unreserved_actions_should_be_removed_or_marked_reserved": true,
          "unmapped_self_audit_results_should_be_connected_or_marked_internal_only": true,
          "authority_heavy_wording_should_be_softened_unless_domain_authority_is_explicit": true
        }
      },
      "placeholder_registry": {
        "template_only": true,
        "purpose": "classify template placeholders by finalization requirement without forcing all optional structures to be filled",
        "required_before_final_release": [
          "domain_identity",
          "domain_purpose",
          "scope",
          "governed_targets",
          "primary_responsibility_boundary",
          "non_responsibility_boundary",
          "activation_conditions",
          "failure_modes",
          "repair_directions",
          "core_principle",
          "metadata_finalization"
        ],
        "conditional_before_final_release": [
          "scoring",
          "severity_model",
          "record_schemas",
          "self_state_audit",
          "audit_to_action",
          "human_or_runtime_review",
          "authority_review",
          "external_constraints",
          "language_variant_policy"
        ],
        "may_remain_empty_with_reason": [
          "test_cases",
          "failure_aliases",
          "compact_status_fields",
          "human_or_runtime_review_conditions",
          "scoring_thresholds"
        ],
        "policy": {
          "empty_required_placeholders_must_not_remain_in_final_definition": true,
          "conditional_placeholders_must_be_filled_or_marked_non_applicable_with_reason": true,
          "optional_placeholders_may_remain_empty_when_not_applicable": true,
          "placeholder_resolution_must_not_invent_domain_substance": true
        }
      },
      "inheritance": {
        "inheritance_mode": "additive_domain_extension",
        "parent_definitions": [
          {
            "syntax_id": "argd",
            "role": "general_reasoning_procedure_governance",
            "required": true
          },
          {
            "syntax_id": "dagd",
            "role": "general_behavior_audit_repair_activation_and_status_governance",
            "required": true
          }
        ],
        "dependency_version_policy": {
          "specific_parent_versions_are_not_hardcoded_in_domain_compatibility_labels": true,
          "parent_version_binding_is_external_to_this_domain_definition": true,
          "version_binding_owner": "runtime_bundle_or_release_manifest"
        },
        "standalone_reference_use": {
          "allowed": true,
          "condition": "standalone_readers_must_treat_parent_mechanisms_as_external_prerequisites_or_reference_context",
          "does_not_grant_parent_functionality": true,
          "runtime_conformance_requires_parent_definitions": true
        },
        "replaces_parent_definitions": false,
        "duplicates_parent_rules": false,
        "parent_rules_remain_authoritative": true,
        "domain_delta_only": true,
        "preserved_parent_mechanism_policy": {
          "inherited_governance_must_be_referenced_not_reexpanded": true,
          "silent_parent_rule_override_prohibited": true,
          "parent_mechanism_lists_must_not_be_recreated_unless_required_by_explicit_context": true
        },
        "conflict_policy": {
          "general_reasoning_conflicts": "resolve_under_parent_reasoning_governance",
          "general_behavior_and_governance_conflicts": "resolve_under_parent_behavior_governance",
          "domain_specific_conflicts": "resolve_under_domain_governance_when_not_in_conflict_with_parent_governance_or_higher_authority",
          "higher_level_system_policies_remain_authoritative": true
        }
      },
      "orchestration_reference": {
        "orchestration_definition": "cdogd",
        "relationship": "external_orchestration_reference",
        "cdogd_is_not_reimplemented_here": true,
        "registry_and_activation_logic_are_external": true,
        "routing_priority_and_domain_selection_are_external": true,
        "registered_domain_extension_storage_is_external": true
      },
      "domain_scope": {
        "domain": "",
        "scope_statement": "",
        "governed_target_categories": [],
        "lifecycle_coverage": [],
        "non_targets": [
          "replacement_of_parent_governance",
          "replacement_of_external_orchestration",
          "absorption_of_sibling_domain_definitions",
          "model_weight_modification",
          "training_data_modification",
          "replacement_of_built_in_system_policies"
        ]
      },
      "domain_delta_slots": {
        "purpose": "declare where domain-specific substance belongs so it does not leak into common template policy",
        "required_domain_slots": [
          "domain_identity",
          "domain_scope",
          "governed_targets",
          "domain_specific_boundaries",
          "domain_specific_failure_modes",
          "domain_specific_required_controls",
          "domain_specific_capabilities",
          "domain_specific_evaluation_axes",
          "domain_specific_repair_origins",
          "domain_specific_activation_conditions",
          "domain_specific_status_signals"
        ],
        "optional_domain_slots": [
          "domain_specific_record_schemas",
          "domain_specific_language_or_variant_policy",
          "domain_specific_external_constraints",
          "domain_specific_examples_or_test_cases"
        ],
        "slot_rules": {
          "slot_content_must_not_redefine_parent_governance": true,
          "slot_content_must_not_absorb_sibling_domain_rules_by_default": true,
          "slot_content_must_not_reimplement_external_orchestration": true,
          "slot_content_must_remain_domain_delta_not_general_system_policy": true,
          "slot_content_must_be_traceable_to_domain_requirements": true
        }
      },
      "abstraction_and_context_policy": {
        "purpose": "prevent domain rules from becoming brittle case-specific prohibitions while allowing context-local specificity when required",
        "rule_bodies_must_use_highest_safe_abstraction_level": true,
        "rule_hardcoding_prohibited_by_default": true,
        "rules_must_be_abstract_by_default": true,
        "case_specific_constraints_must_be_contextual": true,
        "domain_instances_must_not_be_encoded_as_general_rules": true,
        "implementation_details_must_not_become_domain_rules": true,
        "rule_bodies_must_not_hardcode": [
          "specific_tool",
          "specific_platform",
          "specific_repository",
          "specific_external_system",
          "specific_local_workflow",
          "specific_professional_field",
          "specific_creative_style",
          "specific_organization_policy",
          "specific_private_system",
          "specific_user_workflow",
          "specific_medium_or_transport",
          "specific_identifier_policy"
        ],
        "contextual_specificity_conditions": [
          "explicit_user_instruction",
          "identity_or_verification_requires_specific_name",
          "hallucination_prevention_requires_specific_name",
          "system_integrity_requires_specific_constraint",
          "domain_context_or_governed_target_context_would_break_without_specificity"
        ],
        "specificity_handling": {
          "specificity_scope": "domain_local_context_or_governed_target_context",
          "specificity_must_not_be_promoted_to_general_rule_without_basis": true,
          "specificity_must_be_traceable_to_context_or_instruction": true,
          "specificity_must_not_override_higher_authority": true
        },
        "example_policy": {
          "examples_are_non_normative": true,
          "examples_may_illustrate_failures_but_do_not_define_the_rule": true,
          "test_cases_must_remain_separate_from_general_domain_rules": true,
          "examples_must_not_narrow_common_template_scope": true,
          "representative_domain_lists_should_not_be_used_in_common_template": true
        },
        "declared_context_policy_principles": [
          "declared_policy_must_be_fixed_when_material",
          "declared_policy_must_not_be_mixed",
          "declared_policy_must_not_be_silently_changed",
          "declared_policy_must_be_applied_consistently",
          "declared_policy_conflict_must_be_reported_or_repaired"
        ],
        "declared_context_policy_types": [],
        "rule_body_policy": {
          "rule_bodies_define_abstract_failures_not_specific_cases": true,
          "case_specific_detail_must_be_domain_or_target_local_unless_promoted_by_valid_governance_basis": true,
          "specific_names_may_be_used_for_identity_verification_or_hallucination_prevention": true,
          "specific_constraints_may_be_used_when_omission_breaks_system_integrity_or_domain_meaning": true
        },
        "contextual_specificity_exception_policy": {
          "exception_scope": "domain_local_context_or_governed_target_context",
          "exception_must_not_become_general_domain_rule_without_basis": true,
          "exception_must_not_override_higher_authority": true,
          "specificity_required_when": [
            "explicit_user_instruction",
            "identity_or_verification_requires_specific_name",
            "hallucination_prevention_requires_specific_name",
            "system_integrity_requires_specific_constraint",
            "domain_context_or_governed_target_context_would_break_without_specificity"
          ]
        }
      },
      "role_complete_separation": {
        "required": true,
        "principle": "domain definitions must keep source material, domain-specific definition, inherited governance, sibling references, governed targets, domain evaluation, domain repair, activation, status reporting, records, external orchestration, and metadata responsibilities separated",
        "separation_targets": {
          "source_material": "inputs, references, observations, or prior materials used for domain-specific work; source content is not absorbed by default",
          "domain_definition": "domain-specific rules, checks, failures, repair origins, records, and responsibility boundaries",
          "inherited_governance": "parent governance referenced as authoritative context and not re-expanded inside the domain definition",
          "sibling_reference": "other domain definitions referenced only when in scope and not absorbed into this domain definition",
          "governed_target": "the domain-local object, process, decision, output, behavior, relation, or condition being governed",
          "domain_evaluation": "domain-specific checks and evaluation dimensions defined as domain delta only",
          "domain_repair": "domain-specific repair origins and revalidation scopes, not the parent repair cycle itself",
          "activation": "local applicability signals only; routing and priority remain external",
          "status_reporting": "domain delta reporting only, not broad runtime status replacement",
          "records": "optional domain records that remain structurally separate from evaluation, repair, and metadata",
          "external_orchestration": "routing, registry, priority, and activation orchestration remain external to the domain definition",
          "metadata": "identity, authorship, license, repository, and compatibility information remain metadata, not domain rules"
        },
        "non_absorption_rules": [
          "inherited_governance_must_be_referenced_not_reexpanded",
          "sibling_domain_content_must_remain_referenced_not_absorbed",
          "external_orchestration_must_not_be_reimplemented_in_domain_definition",
          "metadata_must_not_be_promoted_to_domain_rule_without_basis",
          "source_material_must_not_be_absorbed_without_domain_reason"
        ],
        "review_implications": [
          "role_separation_check_required_when_source_parent_sibling_or_orchestration_context_is_material",
          "role_mixing_failure_is_material_when_it_changes_domain_responsibility_or_governed_target_purpose"
        ]
      },
      "cross_domain_interference_policy": {
        "purpose": "prevent common template reuse from causing sibling domain absorption, implicit priority conflicts, or cross-domain rule leakage",
        "rules": [
          "sibling_domain_references_must_be_explicit_when_material",
          "sibling_domain_rules_must_not_be_copied_by_default",
          "domain_overlap_must_be_declared_when_material",
          "cross_domain_activation_priority_is_external_to_this_template",
          "domain_specific_rule_conflicts_must_not_be_silently_merged",
          "shared_terms_must_not_imply_shared_authority_without_boundary_statement"
        ],
        "overlap_handling": {
          "overlap_is_allowed": true,
          "overlap_must_preserve_domain_responsibility_boundaries": true,
          "overlap_resolution_owner": "external_orchestration_or_explicit_runtime_context"
        }
      },
      "output_lightness_and_authority_safety_policy": {
        "purpose": "keep generated domain definitions minimal, authority-safe, and domain-proportionate instead of expanding every optional template structure by default",
        "optional_structure_generation_policy": {
          "optional_does_not_mean_fill_required": true,
          "optional_structures_should_remain_disabled_or_empty_without_domain_reason": true,
          "scoring_must_not_be_enabled_only_to_make_the_definition_look_complete": true,
          "severity_must_not_be_enabled_only_to_make_the_definition_look_auditable": true,
          "records_must_not_be_created_only_to_make_the_definition_look_operational": true,
          "audit_to_action_must_not_register_actions_that_are_not_used_reserved_or_payload_targets": true,
          "self_state_audit_must_not_be_strengthened_without_domain_need": true
        },
        "record_schema_minimality_policy": {
          "record_schemas_should_be_domain_minimal": true,
          "records_should_be_required_only_under_material_conditions": true,
          "record_count_should_not_be_increased_for_apparent_completeness": true,
          "record_fields_should_track_required_domain_evidence_not_documentation_exhaustiveness": true,
          "documentation_should_not_expand_all_record_fields_by_default": true
        },
        "authority_verb_safety_policy": {
          "direct_authority_verbs_require_domain_authority": true,
          "restricted_direct_authority_verbs": [
            "block",
            "require",
            "allow",
            "approve",
            "invalidate",
            "escalate"
          ],
          "preferred_authority_safe_patterns_for_non_authority_domains": [
            "report_condition",
            "emit_status",
            "block_ready_claim",
            "request_clarification",
            "recommend_handoff",
            "report_escalation_condition",
            "ready_claim_blocking_is_not_execution_blocking",
            "block_ready_claim_is_allowed_for_non_authority_domains_when_it_blocks_only_status_claims"
          ],
          "ready_or_safety_claim_blocking_is_preferred_over_execution_blocking_when_the_domain_does_not_own_execution_authority": true,
          "domain_must_not_claim_final_approval_or_final_authorization_without_explicit_authority": true
        },
        "human_or_runtime_review_wording_policy": {
          "human_review_required_wording_should_be_avoided_unless_the_domain_owns_review_requirement_authority": true,
          "non_authority_domains_should_report_review_conditions_or_indicators": true,
          "preferred_review_condition_names": [
            "human_or_runtime_review_condition_findings",
            "authority_clarification_conditions",
            "review_escalation_indicators",
            "recommend_human_or_authority_review_when"
          ],
          "review_condition_findings_do_not_themselves_create_external_approval_requirements": true
        },
        "handoff_action_compaction_policy": {
          "large_handoff_target_sets_should_prefer_generic_action_plus_payload_target": true,
          "generic_handoff_action_example": "handoff_to_relevant_domain",
          "payload_target_should_identify_specific_target_when_needed": true,
          "specific_handoff_actions_are_allowed_only_when_domain_reason_makes_them_material": true
        }
      },
      "policy_goal": [],
      "constraints": {
        "prohibited_failure_modes": [
          "role_mixing_failure",
          "parent_governance_reexpansion",
          "sibling_domain_absorption",
          "external_orchestration_logic_absorbed_into_domain_definition",
          "declared_context_policy_inconsistency",
          "domain_instance_promoted_to_general_rule",
          "case_specific_constraint_hardcoded_as_universal_rule",
          "implementation_detail_promoted_to_domain_rule",
          "examples_become_rules",
          "representative_domain_list_narrows_common_template_scope",
          "unresolved_template_placeholder_in_final_definition",
          "domain_delta_slot_unresolved_when_required",
          "record_required_field_group_mapping_failure",
          "evaluation_dimension_alignment_failure",
          "schema_hygiene_failure"
        ],
        "required_controls": [
          "preserve_role_complete_separation",
          "preserve_parent_governance_boundary",
          "preserve_external_orchestration_boundary",
          "preserve_sibling_domain_boundary_when_material",
          "preserve_declared_context_policy_when_material",
          "preserve_template_placeholder_resolution_before_release",
          "preserve_record_required_field_group_mapping_when_records_are_used",
          "preserve_evaluation_dimension_threshold_alignment_when_scoring_is_used"
        ],
        "runtime_constraints": {
          "domain_only": true,
          "does_not_redefine_parent_governance": true,
          "does_not_reimplement_external_orchestration": true,
          "does_not_define_registry_logic": true,
          "does_not_create_case_specific_general_bans": true,
          "does_not_create_identifier_system_specific_general_bans": true,
          "does_not_define_global_domain_priority": true
        },
        "failure_aliases": {},
        "schema_hygiene_constraints": {
          "taxonomy_group_membership_must_match_requirement_level": true,
          "record_required_fields_must_be_mapped_to_field_groups_when_records_exist": true,
          "field_group_items_may_inherit_group_requirement_level_when_not_overridden": true,
          "evaluation_dimensions_must_align_with_thresholds_and_audit_targets_when_scoring_exists": true,
          "critical_invalidation_conditions_must_be_represented_in_critical_severity_rules_when_severity_model_exists": true,
          "collection_shape_must_be_declared_when_using_grouped_objects": true
        },
        "common_rule_index": {
          "abstraction_rules": [
            "rule_bodies_must_use_highest_safe_abstraction_level",
            "rule_hardcoding_prohibited_by_default",
            "rules_must_be_abstract_by_default",
            "case_specific_constraints_must_be_contextual",
            "domain_instances_must_not_be_encoded_as_general_rules",
            "contextual_specificity_conditions_must_remain_local"
          ],
          "role_and_boundary_rules": [
            "role_complete_separation",
            "inherited_governance_must_be_referenced_not_reexpanded",
            "sibling_domain_content_must_remain_referenced_not_absorbed",
            "external_orchestration_must_not_be_reimplemented_in_domain_definition",
            "metadata_must_not_be_promoted_to_domain_rule_without_basis"
          ],
          "cross_domain_rules": [
            "sibling_domain_references_must_be_explicit_when_material",
            "domain_overlap_must_be_declared_when_material",
            "cross_domain_activation_priority_is_external_to_this_template"
          ],
          "template_fill_rules": [
            "finalized_domain_definition_must_resolve_required_placeholders",
            "unresolved_placeholders_must_be_reported_before_publication_or_runtime_use",
            "template_defaults_must_not_be_treated_as_domain_substance"
          ],
          "schema_hygiene_rules": [
            "taxonomy_group_membership_must_match_requirement_level",
            "record_required_fields_must_be_mapped_to_field_groups",
            "evaluation_dimensions_must_align_with_thresholds_and_audit_targets",
            "collection_shape_must_be_declared_when_using_grouped_objects"
